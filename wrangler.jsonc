{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threat-wiki",
  "account_id": "b6d1478423f0bb0c0477df387305e46b",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "threat.wiki", "custom_domain": true, "zone_id": "867b93404f8e123a874dbe3fbf5a0bc0" }
  ],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
